          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Список містить запис\",()=>{const b=pm.response.json();pm.expect(b).to.be.an(\"array\");pm.expect(b.some(x=>x.id===pm.collectionVariables.get(\"student_id\"))).to.eql(true);});"
            ]
          }
        }
      ]
    },
