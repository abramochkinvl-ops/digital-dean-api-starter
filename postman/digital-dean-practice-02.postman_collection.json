{
  "info": {
    "_postman_id": "dc000002-0000-4000-8000-000000000002",
    "name": "Digital Dean — Practice 02",
    "description": "Практична робота 2, варіант 1. Вигадані дані, локальний API. Запускайте всю колекцію послідовно після підготовки звіту вимірювань. Підміна серверного конверта перевіряється в pytest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "student_id",
      "value": ""
    },
    {
      "key": "note_id",
      "value": ""
    },
    {
      "key": "note_text",
      "value": "  Навчальна примітка про індивідуальний план  "
    },
    {
      "key": "other_student_id",
      "value": ""
    },
    {
      "key": "enrollment_year",
      "value": "2026"
    },
    {
      "key": "note_category",
      "value": "academic"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('service is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create synthetic student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('student_id', '');",
              "pm.collectionVariables.set('note_id', '');",
              "pm.collectionVariables.set('other_student_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('response has id', () => pm.expect(pm.response.json().id).to.be.a('string'));",
              "pm.test('enrollment year is retained', () => pm.expect(pm.response.json().enrollment_year).to.eql(Number(pm.collectionVariables.get('enrollment_year'))));",
              "if (pm.response.code === 201) pm.collectionVariables.set('student_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"practice02-{{$guid}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"enrollment_year\": {{enrollment_year}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Create protected note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('student_id')) throw new Error('Create student first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note metadata without internal fields', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.algorithm).to.eql('AES-256-GCM');",
              "  pm.expect(body.category).to.eql(pm.collectionVariables.get('note_category'));",
              "  ['text', 'key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('note_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{note_text}}\",\n  \"category\": \"{{note_category}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Read verified note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('note_id')) throw new Error('Create note first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verified text is preserved exactly', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.eql(pm.collectionVariables.get('note_id'));",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.text).to.eql(pm.collectionVariables.get('note_text'));",
              "  pm.expect(body.category).to.eql(pm.collectionVariables.get('note_category'));",
              "  ['key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}"
      }
    },
    {
      "name": "05 Reject blank note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"   \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('blank note is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject client key field",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Вигадана примітка\", \"key\": \"not-a-real-key\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown input field is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reject unknown student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/00000000-0000-4000-8000-000000000000/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Вигадана примітка\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown student is not found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Read local benchmark report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/lab/crypto/benchmark-results"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('prepared benchmark report is available', () => pm.response.to.have.status(200));",
              "pm.test('report has object structure', () => pm.expect(pm.response.json()).to.be.an('object'));",
              "pm.test('baseline report contains 36 unique combinations', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.schema_version).to.eql(1);",
              "  pm.expect(body.results).to.have.lengthOf(36);",
              "  const groups = body.results.map(row => [row.backend, row.algorithm, row.size_bytes, row.operation].join('|'));",
              "  pm.expect(new Set(groups).size).to.eql(36);",
              "  pm.expect(body.parameters.sizes_bytes).to.eql([1024, 65536, 1048576]);",
              "  pm.expect(body.parameters.operations_per_series).to.eql(100);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Create a second synthetic student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('response has id', () => pm.expect(pm.response.json().id).to.be.a('string'));",
              "pm.test('enrollment year is retained', () => pm.expect(pm.response.json().enrollment_year).to.eql(Number(pm.collectionVariables.get('enrollment_year'))));",
              "if (pm.response.code === 201) pm.collectionVariables.set('other_student_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"practice02-{{$guid}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"enrollment_year\": {{enrollment_year}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Reject note through another existing student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{other_student_id}}/secure-notes/{{note_id}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('another student cannot fetch the note', () => {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json()).not.to.have.property('text');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Reject unknown note category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
        "body": {
          "mode": "raw",
          "raw": "{\"text\":\"Навчальний приклад\",\"category\":\"unknown\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unknown category is rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Read student by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('student remains readable', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(pm.response.json().enrollment_year).to.eql(Number(pm.collectionVariables.get('enrollment_year')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Patch student group",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"group_code\":\"КН-32\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('student update preserves enrollment year', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().group_code).to.eql('КН-32');",
              "  pm.expect(pm.response.json().enrollment_year).to.eql(Number(pm.collectionVariables.get('enrollment_year')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Filter students by enrollment year",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students?enrollment_year={{enrollment_year}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('enrollment filter still works', () => {",
              "  pm.response.to.have.status(200);",
              "  const rows = pm.response.json();",
              "  pm.expect(rows.some(row => row.id === pm.collectionVariables.get('student_id'))).to.eql(true);",
              "  pm.expect(rows.every(row => row.enrollment_year === Number(pm.collectionVariables.get('enrollment_year')))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
