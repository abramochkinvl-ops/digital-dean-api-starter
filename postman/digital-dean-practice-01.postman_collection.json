{
  "info": {
    "name": "Цифровий деканат — ПР1 — варіант 1",
    "description": "24 послідовні перевірки. Перед запуском змінити year_min/year_max згідно з app/institution.json. Дані синтетичні, email унікальні для кожного запуску.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "enrollment_year",
      "value": "2026"
    },
    {
      "key": "year_min",
      "value": "2000"
    },
    {
      "key": "year_max",
      "value": "2030"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith(\"01\")) {",
          "const run=Date.now().toString()+Math.random().toString(16).slice(2,8);",
          "pm.collectionVariables.set(\"run_id\",run);",
          "pm.collectionVariables.set(\"student_email\",\"student.\"+run+\"@example.com\");",
          "pm.collectionVariables.set(\"duplicate_email\",(\"student.\"+run+\"@example.com\").toUpperCase());",
          "pm.collectionVariables.set(\"year_below\",Number(pm.collectionVariables.get(\"year_min\"))-1);",
          "pm.collectionVariables.set(\"year_above\",Number(pm.collectionVariables.get(\"year_max\"))+1);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Готовність",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Точне тіло\", () => pm.expect(pm.response.json()).to.eql({status:\"ok\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Створення",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/students",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"{{student_email}}\",\n  \"group_code\": \"КН-31\",\n  \"enrollment_year\": {{enrollment_year}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.test(\"UUID та дані\", () => {pm.expect(b.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);pm.expect(b.enrollment_year).to.eql(Number(pm.collectionVariables.get(\"enrollment_year\")));pm.expect(b.group_code).to.eql(\"КН-31\");});",
              "pm.collectionVariables.set(\"student_id\",b.id);",
              "pm.collectionVariables.set(\"student_body\",JSON.stringify(b));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Список",
      "request": {
